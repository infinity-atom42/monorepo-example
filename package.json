{
	"name": "asapreverse",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"auth:generate": "turbo run auth:generate",
		"auth:migrate": "turbo run auth:migrate",
		"auth:push": "turbo run auth:push",
		"build": "turbo run build",
		"clean": "turbo run clean && rm -rf .turbo node_modules .test",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:push": "turbo run db:push",
		"db:seed": "turbo run db:seed",
		"dev": "turbo run dev",
		"format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
		"format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
		"lint": "turbo run lint",
		"start": "turbo run start",
		"test": "turbo run test",
		"type:check": "turbo run type:check"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.1.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.0",
		"@packages/config": "workspace:*",
		"@types/node": "^24.10.1",
		"eslint": "^9.39.1",
		"knip": "^5.71.0",
		"prettier": "^3.7.3",
		"prettier-plugin-nginx": "^1.0.3",
		"prettier-plugin-packagejson": "^2.5.20",
		"prettier-plugin-sh": "^0.18.0",
		"prettier-plugin-sql": "^0.19.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"turbo": "^2.6.1",
		"typescript": "5.9.3"
	},
	"packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
	"engines": {
		"node": ">=22"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide",
		"core-js-pure",
		"sharp"
	]
}
